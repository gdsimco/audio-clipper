{
  "name": "audio-clipper",
  "productName": "Audio Clipper",
  "version": "0.1.0",
  "description": "A tiny, friendly audio clip trimmer, cutter and splitter.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.mjs",
    "icon": "electron scripts/make-icon.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "mac": "mac/build.sh",
    "install:mac": "mac/install.sh --default"
  },
  "dependencies": {
    "lamejs": "1.2.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.audioclipper.app",
    "productName": "Audio Clipper",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/lamejs/lame.min.js",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      { "ext": ["mp3", "wav", "flac", "ogg", "oga", "opus", "m4a", "aac", "webm"], "name": "Audio", "role": "Editor" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    }
  }
}
